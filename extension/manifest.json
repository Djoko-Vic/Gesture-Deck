{
  "manifest_version": 3,
  "name": "RemoteControl",
  "version": "1.0.0",
  "description": "GestureDeck RemoteControl - Direct visual scrubber drag, site-only volume, and air-gesture control for YouTube",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RemoteControl"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
